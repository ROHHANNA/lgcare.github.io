
@charset "utf-8";
/*CSS Document*/

/*++++++++  Media Query  ++++++++*/
/*------- Mobile(start)  -----*/
@media screen and (max-width: 767px) {
	
    div.inner_wrap { width: 100%; max-width: 290px; margin: 0 auto; }
	div.inno_wrap { width: 100%; max-width: 290px; margin: 0 auto; }
	
	a.bdr_act::before, a.bdr_act::after { content:""; position: absolute; width: 0; height: 0; }
	a.bdr_act[class~="bdr3"]::before, a.bdr_act[class~="bdr3"]::after { border: 3px solid transparent; }
	a.bdr_act[class~="bdr2"]::before, a.bdr_act[class~="bdr2"]::after { border: 2px solid transparent; }
	a.bdr_act[class~="bdr1"]::before, a.bdr_act[class~="bdr1"]::after { border: 1px solid transparent; }
	a.bdr_act::before { top: 0; left: 0;  }/*[class~="bdr1"] class의 값들중에서 bdr1이 포함될때*/
	a.bdr_act::after { bottom: 0; right: 0; }
	a.bdr_act:hover::before { border-top-color: #d4af37; border-right-color: #d4af37; width: 100%; height: 100%; background: transparent;
	transition: width 0.2s ease-out, height 0.2s ease-out 0.2s; }
	a.bdr_act:hover::after { border-bottom-color: #d4af37; border-left-color: #d4af37; width: 100%; height: 100%; background: transparent;
	transition: border-color 0s ease-out 0.4s, width 0.2s ease-out 0.4s, height 0.2s ease-out 0.6s;  } 
	
	header {position: fixed;  top: 0; left: 0; z-index: 90; width: 100%;  height: 70px; background: #fff; border-bottom: 1px solid #eeeeee;} 
	header > div.inner_wrap { position: relative; height: 70px; width: 80%;}
	header > div.inner_wrap > h1 { display: block; width: 20%; height: 70px; position: absolute; left:40%; top:0;  } 
	header > div.inner_wrap > h1 > a { display: block; width: 100%; height: 100%; font-size: 1px; text-indent: -99999em; background:url("../images/logo.png")no-repeat center center;}

	header > div.inner_wrap > nav { overflow-y: scroll; display: block; position: fixed; left: 0; top: 0; z-index: 99; width: 100%; height: auto; padding: 0 20px; 
	background: #fff; transform: translate(100%); transition: transform 0.3s;  border-bottom:1px solid #e1e0e0; margin-top: 65px; }

	header > div.inner_wrap > nav {  width: 100%; padding-bottom: 15px; }
	header > div.inner_wrap > nav > ul { width: 100%;}
	header > div.inner_wrap > nav > ul > li {  float: left; width: 100%;  position: relative;   height: auto; text-align: left; border-top: 1px solid #e1e0e0; margin: 5px 0;}
	header > div.inner_wrap > nav > ul > li:after { content: ""; position: absolute; top: 18px; right: 0px;  display: block; width: 18px; height: 18px;  
	background:url("../images/nav_arrow.png")no-repeat center center; margin-right: 10px;}	
	header > div.inner_wrap > nav > ul > li > a { display: inline-block; height: 35px; padding: 7px 10px; color: #000; line-height: 35px; font-size: 1.0625em;  font-family: 'NotoSansKR-Medium'; width: 100%;} 
	header > div.inner_wrap > nav > ul > li > ul { display: none; overflow: hidden; width: 100%; height: auto; background: #fff; }
	header > div.inner_wrap > nav > ul > li.active > ul { display: block; }
	header > div.inner_wrap > nav > ul > li:hover > ul { display: block; }
	header > div.inner_wrap > nav > ul > li > ul > li { float: left; width: 100%;  }
	header > div.inner_wrap > nav > ul > li > ul > li > a {  display: block; width: 100%; padding: 7px 0; text-align: left; color: #000; font-size: 0.9375em; }
	header > div.inner_wrap > nav > ul > li > ul > li > a.first {  border-top: 1px solid #e1e0e0; margin-top: 10px; padding-top: 15px;}
	header > div.inner_wrap > nav > ul > li > ul > li > a:hover {  color: #bb000d; } 
	header > div.inner_wrap > nav > ul > li > ul > li > a > span { padding-right: 10px; }
		
	 button.btn_back { overflow: hidden; display: block; position: absolute; left: 20px; top: 25px;
	width:23px; height:23px; background: url("../images/nav_leftarrow.png") no-repeat ; text-indent: -999999em; background-size: cover; }
	 button.btn_menu_toggle { overflow: hidden; display: block; position: absolute; 
	right: 20px; top: 16px; z-index: -100; width: 35px; height: 35px; background: url("../images/nav_menu_t.png") no-repeat ; background-size: cover;  text-indent: -9999em; }
	

	/* footer */
	footer { padding: 30px 0px; background: #ebebeb; width: 100%; height: 254px;}
	footer > div.inner_wrap > ul { margin-bottom: 15px;  }
	footer > div.inner_wrap > ul > li { display: inline-block; position: relative; padding: 0 15px; font-size: 0.875em; line-height: 1; }
	footer > div.inner_wrap > ul > li > a { display: inline-block; color: #666; }
	footer > div.inner_wrap > ul > li::after { content: ""; display: block; position: absolute; right: 0; top: 1px; width: 1px; height: 1em; background: #b1b1b1; }
	footer > div.inner_wrap > ul > li:last-child::after { display: none; }
	footer > div.inner_wrap > div.logo { display: none; }
	footer > div.inner_wrap > div.logo > img { display:none; }
	footer > div.inner_wrap > div.info { display: table-cell;  font-size: 0.6875em; color: #666; vertical-align: middle; padding-left: 15px;}
	footer > div.inner_wrap > div.info > p > span { margin-right: 20px; }


}
/*---------   Moblie(end)   ----*/


/*------- Tablet(start)  -----*/
@media screen and (min-width: 768px) and (max-width: 1024px) {

 
    div.inner_wrap { width: 100%; max-width: 728px; margin: 0 auto; }
	div.inno_wrap { width: 100%; max-width: 728px; margin: 0 auto; }

	
	header {position: fixed;  top: 0; left: 0; z-index: 90; width: 100%;  height: 90px; background: #fff; border-bottom: 1px solid #eeeeee;} 
	header  div.inner_wrap { position: relative; height: 90px; width: 10%; }
	header  div.inner_wrap > h1 { display: block; position: absolute; left:10%; top:0; width: 100%; height: 90px; margin:0 auto;  } 
	header  div.inner_wrap > h1 > a { display: block; width: 100%; height: 100%; font-size: 1px; text-indent: -99999em; background:url("../images/logo.png")no-repeat center center;}

	header  div.inner_wrap > nav { display: block; position: fixed; left: 0; top: 0; z-index: 99; width: 100%; height: auto; padding: 0 20px; 
	background: #fff; transform: translate(100%); transition: transform 0.3s;  border-bottom:1px solid #e1e0e0;margin-top: 85px; padding-bottom: 15px;}

	header  div.inner_wrap > nav > ul { width: 100%;}
	header  div.inner_wrap > nav > ul > li {  float: left; width: 100%;  position: relative;   height: auto; text-align: left; border-top: 1px solid #e1e0e0; margin: 5px 0;}
	header  div.inner_wrap > nav > ul > li:after { content: ""; position: absolute; top: 18px; right: 0px;  display: block; width: 18px; height: 18px;  
	background:url("../images/nav_arrow.png")no-repeat center center; margin-right: 10px;}	
	header  div.inner_wrap > nav > ul > li > a { display: inline-block; height: 35px; padding: 7px 10px; color: #000; line-height: 35px; font-size: 1.0625em;  font-family: 'NotoSansKR-Medium';} 
	header  div.inner_wrap > nav > ul > li > ul { display: none; overflow: hidden; width: 100%; height: auto; background: #fff; }
	header  div.inner_wrap > nav > ul > li.active > ul { display: block;}
	header  div.inner_wrap > nav > ul > li:hover > ul { display: block; }
	header  div.inner_wrap > nav > ul > li > ul > li { float: left; width: 100%;  }
	header  div.inner_wrap > nav > ul > li > ul > li > a {  display: block; width: 100%; padding: 7px 0; text-align: left; color: #000; font-size: 0.9375em; }
	header  div.inner_wrap > nav > ul > li > ul > li > a.first {  border-top: 1px solid #e1e0e0; margin-top: 10px; padding-top: 15px;}
	header  div.inner_wrap > nav > ul > li > ul > li > a:hover {  color: #bb000d; } 
	header  div.inner_wrap > nav > ul > li > ul > li > a > span { padding-right: 10px; }
		
	 button.btn_back { overflow: hidden; display: block; position: absolute; left: 20px; top: 30px;
	width: 45px; height: 45px; background: url("../images/nav_leftarrow.png") no-repeat ; text-indent: -999999em; }
	 button.btn_menu_toggle { overflow: hidden; display: block; position: absolute; 
	z-index: -200; width: 34px; height: 34px; background: url("../images/nav_menu_t.png") no-repeat ; text-indent: -9999em; }


	
	



	/* footer */
	footer { padding: 30px 0px; background: #ebebeb; width: 100%; height: auto;}
	footer > div.inner_wrap > ul { margin-bottom: 10px;  }
	footer > div.inner_wrap > ul > li { display: inline-block; position: relative; padding: 0 15px; font-size: 0.875em; line-height: 1; }
	footer > div.inner_wrap > ul > li > a { display: inline-block; color: #666; }
	footer > div.inner_wrap > ul > li::after { content: ""; display: block; position: absolute; right: 0; top: 1px; width: 1px; height: 1em; background: #b1b1b1; }
	footer > div.inner_wrap > ul > li:last-child::after { display: none; }
	footer > div.inner_wrap > div.logo { display: none; }
	footer > div.inner_wrap > div.logo > img { display:none; }
	footer > div.inner_wrap > div.info { display: table-cell;  font-size: 0.75em; color: #666; vertical-align: middle; padding-left: 15px;}
	footer > div.inner_wrap > div.info > p > span { margin-right: 20px;}
	footer > div.inner_wrap > div.info br { display: none; }
	


	




}
/*---------   Tablet(end)   ----*/

/*++++++++++++++++++++++++++++++++*/
/*-------   Desktop(start)   -----*/

	
	div.inner_wrap { width: 100%; max-width: 1200px; margin: 0 auto; }
	div.inner_wrap2 { width: 100%; max-width: 1200px; margin: 0 auto; }
	
	
	header { top: 0; left: 0; z-index: 90; width: 100%; height: 79px; background: #fff; border-bottom: 1px solid #dfdfdf; } 
	header > div.inner_wrap { position: relative; height: 80px; width: 100%;}
	header > div.inner_wrap > h1 { display: block;  height: 100%; position: absolute; left:0; top:0; text-align: center;} 
	header > div.inner_wrap > h1 > a { display: block; width: 233px; height: 66px; font-size: 1px; text-indent: -99999em; background:url("../images/logo.png")no-repeat center center;}
	header  div.call_main { position: absolute; width: 217px; top:0; right: 0;  }
	header  div.call_main img { float: left;  margin-right: 8px; }
	header  div.call_main p.title { float: left;  color: #808080; font-size: 17px; }
	header  div.call_main p.call_umber { font-size: 1.25em; color: #333; font-weight: bold; }

	header  nav {  float: left; width: 100%; border-bottom:1px solid #dfdfdf; background-color: #fff; }
	header  div.inner_wrap2 { position: relative; height: 45px; width: 100%; }
	header  nav  ul { width: 100%; text-align: center;  }
	header  nav  ul > li {  display: inline-block; width: 130px; position: relative;  height: 45px; text-align: center; }
	header  nav  ul > li > a { display: inline-block; font-size: 16px; height: 50px; padding: 4px 0px; font-family: 'NotoSansKR-Medium'; color: #333333; line-height: 35px; } 
	header  nav  ul > li > ul { display: none; position: absolute; top: 46px; left: 50%; width: 156px; height: 100px; text-align: center;
	background-color: #fff; border: 1px solid #dfdfdf; border-top: 0px; transform: translateX(-50%);  }
	header  nav  ul > li:hover > a { color: #a50034; }
	header  nav  ul > li:hover > ul { display: block;  }
	header  nav  ul > li > ul > li { width: 156px;  height: 50px;  font-family: 'NotoSansKR-Regular';}
	header  nav  ul > li > ul > li:nth-child(1) { border-bottom: 1px solid #dfdfdf; }
	header  nav  ul > li > ul.clearfix { padding-top: 0px; }
	header  nav  ul > li > ul > li > a { position: relative; display: inline-block; width: 100%; padding-right: 5px; margin-top: 4px; text-align: center;  font-size: 14px;}
	header  nav  ul > li > ul > li > a > span { display: none; }
	header > button { display: none; font-size: 1px; text-indent: -9999em;}

	
	div.btn_word { position: relative;  top:0; width: 343px; height: 50px;  margin: 20px auto; z-index: 100;}
	div.btn_word input.search { width: 343px; height: 48px; border-radius: 10px; border: 1px solid;  padding: 0 20px; font-size: 16px; font-family: 'NotoSansKR-Medium'; margin-top: 4px; }
	div.btn_word input::placeholder { font-size: 16px; color: #848383; }
	div.btn_word input.submit { position: absolute; top:9px; right:1px;  background:url("../images/search.png")no-repeat center center; border: none;
	color: #fff; padding: 10px 20px; cursor: pointer; margin: 0 5px; vertical-align: middle; font-size: 15px; text-indent: -999em; }



	/* footer */
	footer { background: #fff; }
	footer > div.footer_utils { background-color: #333333; padding: 10px 0; }
	footer > div.footer_utils > div.inner_wrap2 > a { color: #fff;  font-size: 15px; font-family: 'NotoSansKR-Medium'; }
	footer > div.inner_wrap { margin: 30px auto; }
	footer > div.inner_wrap > ul { margin: 0 0 11px 161px; }
	footer > div.inner_wrap > ul > li { display: inline-block; position: relative; padding: 0 20px; font-size: 0.875em; line-height: 1; }
	footer > div.inner_wrap > ul > li > a { display: inline-block; color: #666; }
	footer > div.inner_wrap > ul > li::after { content: ""; display: block; position: absolute; right: 0; top: 1px; width: 1px; height: 1em; background: #b1b1b1; }
	footer > div.inner_wrap > ul > li:last-child::after { display: none; }
	footer > div.inner_wrap > div.logo { display: table-cell; width: 80px; text-align: center; padding-top: 10px; }
	footer > div.inner_wrap > div.info { display: table-cell; width: 880px; padding-left: 20px; font-size: 12px; color: #666; vertical-align: middle; }
	footer > div.inner_wrap > div.info > p { }
	footer > div.inner_wrap > div.info > p > span { margin-right: 20px;}
	footer > div.inner_wrap > div.info br { display: none; }
	footer select { width: 132px; height: 24px; margin-left: 952px; font-size: 12px; }
	footer select option { vertical-align: bottom; }
	
	/*scroll_top*/
	div.scroll_top { position: fixed; width: 50px; height: 50px; bottom: 15px; right: 10px; z-index: 100; }




